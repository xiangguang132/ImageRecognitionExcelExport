# SQLite 数据库连接（二选一，默认开发库）
# - 本地开发/测试：dev.db（测试账号脚本只能跑在这个库上）
# - 云服务器生产：prod.db（线上真实数据，禁止跑 seed-test-data）
DATABASE_URL="file:./dev.db"

# 千问视觉 API Key（从 https://dashscope.console.aliyun.com/ 获取）
QWEN_API_KEY=your-api-key-here

# JWT 鉴权配置（生产环境请换成随机长字符串）
JWT_SECRET=change-me-to-a-random-secret-in-production

# 初始管理员账号（虚拟管理员，不在数据库落盘）
ADMIN_EMAIL=admin@system.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=系统管理员
